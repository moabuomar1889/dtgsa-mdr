# Browser-safe MDR configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only MDR configuration
DATABASE_URL=
DIRECT_URL=
APP_ENCRYPTION_KEY=
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_SOURCE=source-files
SUPABASE_STORAGE_BUCKET_GENERATED=generated-files
SUPABASE_STORAGE_BUCKET_SIGNATURES=signature-files
SUPABASE_STORAGE_BUCKET_TEMP=temp-files

# Identity transition
AUTH_MODE=LEGACY_SUPABASE
AUTH_COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_WORKSPACE_ALLOWED_DOMAINS=
GOOGLE_DIRECTORY_SYNC_ENABLED=false
GOOGLE_ADMIN_EMAIL=
INTERNAL_SESSION_TTL_MINUTES=480
EXTERNAL_SESSION_TTL_MINUTES=60
OIDC_TRANSACTION_TTL_MINUTES=10
RECENT_AUTH_WINDOW_MINUTES=15
MAGIC_LINK_TTL_MINUTES=30
MAGIC_LINK_SECRET=

# Optional operational metadata
APP_ENVIRONMENT=local
APP_VERSION=0.1.0
GIT_COMMIT_SHA=local
BUILD_TIME=local
APPROVE_PUBLIC_ORIGIN=http://127.0.0.1:3001
