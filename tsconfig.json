{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./apps/mdr-web/src/*"],
      "@dtg/authorization": ["./packages/authorization/src/index.ts"],
      "@dtg/configuration": ["./packages/configuration/src/index.ts"],
      "@dtg/contracts": ["./packages/contracts/src/index.ts"],
      "@dtg/database": ["./packages/database/src/index.ts"],
      "@dtg/document-control-domain": ["./packages/document-control-domain/src/index.ts"],
      "@dtg/observability": ["./packages/observability/src/index.ts"],
      "@dtg/pdf-engine": ["./packages/pdf-engine/src/index.ts"],
      "@dtg/ui": ["./packages/ui/src/index.tsx"]
    }
  },
  "include": ["tests/**/*.ts", "scripts/**/*.ts", "apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "packages/**/*.tsx"],
  "exclude": ["node_modules", "**/.next/**", "**/dist/**"]
}
