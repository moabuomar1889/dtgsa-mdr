{
  "name": "dtg-signature-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev:mdr": "pnpm --filter @dtg/mdr-web dev",
    "dev:approve": "pnpm --filter @dtg/approve-web dev",
    "dev:verify": "pnpm --filter @dtg/verify-web dev",
    "dev:api": "pnpm --filter @dtg/platform-api dev",
    "dev:worker": "pnpm --filter @dtg/worker dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node scripts/run-database-characterization.mjs all",
    "test:unit": "tsx --conditions=react-server --test --test-concurrency=1 tests/unit/database-safety.test.ts tests/unit/phase-3-database-foundation.test.ts tests/unit/phase-4-identity-and-access.test.ts tests/unit/phase-5-controlled-storage.test.ts tests/unit/phase-6-manifest-and-evidence.test.ts tests/unit/phase-7-workflow-engine.test.ts tests/unit/phase-8-cover-designer.test.ts tests/unit/phase-9-approval-application.test.ts tests/architecture/phase-2-foundation.test.ts",
    "test:characterization": "tsx --conditions=react-server --test --test-concurrency=1 tests/characterization/index.test.ts",
    "test:db:up": "node scripts/run-database-characterization.mjs database-check",
    "test:db:wait": "node scripts/run-database-characterization.mjs database-check",
    "test:db:migrate": "node scripts/run-database-characterization.mjs migration-check",
    "test:db:seed": "node scripts/run-database-characterization.mjs seed-check",
    "test:db:upgrade": "node scripts/run-database-characterization.mjs upgrade-check",
    "test:integration": "node scripts/run-database-characterization.mjs integration",
    "test:db:down": "node scripts/run-database-characterization.mjs clean",
    "test:db:clean": "node scripts/run-database-characterization.mjs clean",
    "test:ci": "pnpm run test",
    "build": "pnpm -r --if-present build",
    "build:mdr": "pnpm --filter @dtg/mdr-web build",
    "build:approve": "pnpm --filter @dtg/approve-web build",
    "build:verify": "pnpm --filter @dtg/verify-web build",
    "build:api": "pnpm --filter @dtg/platform-api build",
    "build:worker": "pnpm --filter @dtg/worker build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "docs:validate": "node scripts/validate-phase-2-docs.mjs && node scripts/validate-phase-3-docs.mjs && node scripts/validate-phase-4-docs.mjs && node scripts/validate-phase-5-docs.mjs && node scripts/validate-phase-6-docs.mjs && node scripts/validate-phase-7-docs.mjs && node scripts/validate-phase-8-docs.mjs && node scripts/validate-phase-9-docs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx scripts/seed-foundation.ts",
    "docs:validate:phase1": "node scripts/validate-phase-1-docs.mjs",
    "docs:validate:phase1.5": "node scripts/validate-phase-1-5-docs.mjs",
    "check:libreoffice": "node scripts/check-libreoffice.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "dotenv": "^17.3.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "^7.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "xlsx": "^0.18.5"
  }
}
