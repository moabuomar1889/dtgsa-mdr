{
  "name": "dtg-signature-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev:mdr": "pnpm --filter @dtg/mdr-web dev",
    "dev:approve": "pnpm --filter @dtg/approve-web dev",
    "dev:verify": "pnpm --filter @dtg/verify-web dev",
    "dev:api": "pnpm --filter @dtg/platform-api dev",
    "dev:worker": "pnpm --filter @dtg/worker dev",
    "local:setup": "node scripts/local/runtime.mjs setup",
    "local:seed": "node scripts/local/runtime.mjs seed",
    "local:up": "node scripts/local/runtime.mjs up",
    "local:demo": "node scripts/local/runtime.mjs demo",
    "local:status": "node scripts/local/runtime.mjs status",
    "local:acceptance": "node scripts/local/acceptance.mjs",
    "local:qpdf": "node scripts/local/qpdf-acceptance.mjs",
    "local:backup-restore": "node scripts/local/backup-restore.mjs",
    "local:down": "node scripts/local/runtime.mjs down",
    "local:reset": "node scripts/local/runtime.mjs reset",
    "local:clean": "node scripts/local/runtime.mjs clean",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node scripts/run-database-characterization.mjs all",
    "test:unit": "tsx --conditions=react-server --test --test-concurrency=1 tests/unit/database-safety.test.ts tests/unit/phase-3-database-foundation.test.ts tests/unit/phase-4-identity-and-access.test.ts tests/unit/phase-5-controlled-storage.test.ts tests/unit/phase-6-manifest-and-evidence.test.ts tests/unit/phase-7-workflow-engine.test.ts tests/unit/phase-8-cover-designer.test.ts tests/unit/phase-9-approval-application.test.ts tests/unit/phase-10-downloads-and-worker.test.ts tests/unit/phase-11-client-responses.test.ts tests/unit/phase-12-verification-portal.test.ts tests/unit/phase-13-integrations.test.ts tests/unit/phase-14-operations.test.ts tests/unit/phase-15-final-acceptance.test.ts tests/unit/phase-16l-local-acceptance.test.ts tests/unit/pdi-import-reconciliation.test.ts tests/architecture/phase-2-foundation.test.ts",
    "test:characterization": "tsx --conditions=react-server --test --test-concurrency=1 tests/characterization/index.test.ts",
    "test:db:up": "node scripts/run-database-characterization.mjs database-check",
    "test:db:wait": "node scripts/run-database-characterization.mjs database-check",
    "test:db:migrate": "node scripts/run-database-characterization.mjs migration-check",
    "test:db:seed": "node scripts/run-database-characterization.mjs seed-check",
    "test:db:upgrade": "node scripts/run-database-characterization.mjs upgrade-check",
    "test:integration": "node scripts/run-database-characterization.mjs integration",
    "test:db:down": "node scripts/run-database-characterization.mjs clean",
    "test:db:clean": "node scripts/run-database-characterization.mjs clean",
    "test:ci": "pnpm run test",
    "test:e2e:local": "playwright test --config playwright.local.config.ts",
    "build": "pnpm -r --if-present build",
    "build:mdr": "pnpm --filter @dtg/mdr-web build",
    "build:approve": "pnpm --filter @dtg/approve-web build",
    "build:verify": "pnpm --filter @dtg/verify-web build",
    "build:api": "pnpm --filter @dtg/platform-api build",
    "build:worker": "pnpm --filter @dtg/worker build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:no-supabase": "node scripts/check-no-supabase.mjs",
    "docs:validate": "node scripts/validate-phase-2-docs.mjs && node scripts/validate-phase-3-docs.mjs && node scripts/validate-phase-4-docs.mjs && node scripts/validate-phase-5-docs.mjs && node scripts/validate-phase-6-docs.mjs && node scripts/validate-phase-7-docs.mjs && node scripts/validate-phase-8-docs.mjs && node scripts/validate-phase-9-docs.mjs && node scripts/validate-phase-10-docs.mjs && node scripts/validate-phase-11-docs.mjs && node scripts/validate-phase-12-docs.mjs && node scripts/validate-phase-13-docs.mjs && node scripts/validate-phase-14-docs.mjs && node scripts/validate-phase-15-docs.mjs && node scripts/validate-phase-16l-docs.mjs && node scripts/validate-phase-16-1-docs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx scripts/seed-foundation.ts",
    "docs:validate:phase1": "node scripts/validate-phase-1-docs.mjs",
    "docs:validate:phase1.5": "node scripts/validate-phase-1-5-docs.mjs",
    "check:libreoffice": "node scripts/check-libreoffice.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "dotenv": "^17.3.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@dtg/client-response-domain": "workspace:*",
    "@dtg/integration-domain": "workspace:*",
    "@dtg/integration-sdk": "workspace:*",
    "@dtg/job-engine": "workspace:*",
    "@dtg/local-acceptance": "workspace:*",
    "@dtg/verification-domain": "workspace:*",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "^7.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
