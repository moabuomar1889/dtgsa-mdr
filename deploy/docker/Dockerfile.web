# Pin the full base version. Production promotion records the resolved digest.
FROM node:24.4.1-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable && corepack prepare pnpm@11.17.0 --activate
WORKDIR /workspace

FROM base AS dependencies
COPY . .
RUN pnpm install --frozen-lockfile

FROM dependencies AS builder
ARG APP
ENV NEXT_TELEMETRY_DISABLED=1 NEXT_PHASE=phase-production-build
RUN test "$APP" = "mdr-web" -o "$APP" = "approve-web" -o "$APP" = "verify-web"
RUN mkdir -p "apps/${APP}/public" && pnpm --filter "@dtg/${APP}" build

FROM node:24.4.1-bookworm-slim AS runtime
ARG APP
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0 WEB_APP=${APP}
WORKDIR /app
RUN groupadd --system --gid 1001 dtg && useradd --system --uid 1001 --gid dtg dtg
COPY --from=builder --chown=dtg:dtg /workspace/apps/${APP}/.next/standalone ./
COPY --from=builder --chown=dtg:dtg /workspace/apps/${APP}/.next/static ./apps/${APP}/.next/static
COPY --from=builder --chown=dtg:dtg /workspace/apps/${APP}/public ./apps/${APP}/public
USER dtg
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["sh", "-c", "exec node apps/${WEB_APP}/server.js"]
