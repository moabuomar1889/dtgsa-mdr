  content             Json
  createdAt           DateTime                  @default(now())
  packageHash         String?
  version             WorkflowDefinitionVersion @relation(fields: [definitionVersionId], references: [id], onDelete: Restrict)
  steps               WorkflowSnapshotStep[]
  cycles              ApprovalCycle[]
}

model WorkflowSnapshotStep {
  id                 String           @id @default(cuid())
  snapshotId         String
  stepKey            String
  stepOrder          Int
  assignmentSnapshot Json
  required           Boolean
  quorum             Int
  parallelGroupId    String?
  policySnapshot     Json?
  snapshot           WorkflowSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, stepKey])
}

model ApprovalCycle {
  id                 String                 @id @default(cuid())
  revisionId         String
  snapshotId         String
  cycleNumber        Int
  status             String                 @default("Active")
  isActive           Boolean                @default(true)
  contentHash        String
  startedAt          DateTime               @default(now())
  completedAt        DateTime?
  invalidatedAt      DateTime?
  invalidationReason String?
  revision           DocumentRevision       @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  snapshot           WorkflowSnapshot       @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  steps              WorkflowStepInstance[]

  @@unique([revisionId, cycleNumber])
  @@index([revisionId, isActive])
}

model WorkflowStepInstance {
  id                   String        @id @default(cuid())
  approvalCycleId      String
  stepKey              String
  status               String        @default("Pending")
  expectedStateVersion Int           @default(0)
  startedAt            DateTime?
  completedAt          DateTime?
  stepOrder            Int           @default(0)
  parallelGroupId      String?
  required             Boolean       @default(true)
  quorum               Int           @default(1)
  policySnapshot       Json?
  cycle                ApprovalCycle @relation(fields: [approvalCycleId], references: [id], onDelete: Restrict)

  @@unique([approvalCycleId, stepKey])
}

model WorkflowAssignment {
  id                     String    @id @default(cuid())
  stepInstanceId         String
  assigneeType           String
  assigneeId             String
  snapshot               Json
  assignedAt             DateTime  @default(now())
  reassignmentRequiredAt DateTime?
  reassignmentReason     String?

  @@unique([stepInstanceId, assigneeType, assigneeId])
}

model ApprovalDecision {
